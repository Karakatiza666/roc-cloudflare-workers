{
  "name": "roc-hello",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "roc build --target=wasm32 --no-cache --output=app.wasm app.roc && roc-cloudflare-workers sync",
    "sync": "roc-cloudflare-workers sync",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "roc-cloudflare-workers": "https://github.com/Karakatiza666/roc-cloudflare-workers/releases/download/X.Y.Z/roc-cloudflare-workers-X.Y.Z.tgz"
  }
}
