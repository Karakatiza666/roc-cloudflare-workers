+path_in : Cbor.State, U64, List(Cbor.Step) -> Try(List(Cbor.Step), [NotFound])
+path_in = |state, pos, path| {
+	if state.pos == pos {
+		return Ok(path)
+	}
+	h = head(state) ? |_| NotFound
+	if h.major != 4 and h.major != 5 {
+		return Err(NotFound)
+	}
+	var $s = at(state, h.next)
+	var $i = 0.U64
+	while $i < h.arg {
+		key =
+			if h.major == 5 {
+				k = text($s) ? |_| NotFound
+				$s = k.rest
+				Key(k.value)
+			} else {
+				Index($i)
+			}
+		end = skip($s) ? |_| NotFound
+		if pos >= $s.pos and pos < end.pos {
+			return path_in($s, pos, path.append(key))
+		}
+		$s = end
+		$i = $i + 1
+	}
+	Err(NotFound)
+}
