+## A canonical decimal integer: `0`, or an optional `-` and a digit 1 to 9, then digits. At most 20 digits.
+decimal : Str -> Try(I128, [NotDecimal])
+decimal = |s| {
+	bytes = s.to_utf8()
+	(neg, digits) = match bytes {
+		['-', .. as rest] => (Bool.True, rest)
+		_ => (Bool.False, bytes)
+	}
+	ok = match digits {
+		['0'] => Bool.not(neg)
+		[first, ..] => first >= '1' and first <= '9' and digits.len() <= 20 and digits.all(|d| d >= '0' and d <= '9')
+		[] => Bool.False
+	}
+	if ok {
+		n = digits.fold(0.I128, |acc, d| acc * 10 + (d - '0').to_i128())
+		Ok(if neg -n else n)
+	} else {
+		Err(NotDecimal)
+	}
+}
