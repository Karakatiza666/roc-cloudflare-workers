+}
+
+## VERIFY: `mb` MiB and 100 bytes from a writer with no length: a multipart upload.
+vput_big! : Str, U64 => Response
+vput_big! = |key, mb| match Body.writer!({}) {
+	Err(BodyErr(t)) => Response.from_text(200, "writer ${t.name}")
+	Ok({ body, writer }) => {
+		for i in 0.U64.until(mb) {
+			_ = Io.start!(writer.write(List.repeat(65 + i.to_u8_wrap(), 1_048_576)))
+		}
+		_ = Io.start!(writer.write(List.repeat(90, 100)))
+		writer.close!()
+		out(bucket.put_with!(key, body, { http: { content_type: "text/x-big" } }), show_meta)
+	}
 }
 
